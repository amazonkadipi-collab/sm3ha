{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "dist/public",
  "framework": null,
  "rewrites": [
    {
      "source": "/:path((?!api(?:/|$)|manus-storage(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
